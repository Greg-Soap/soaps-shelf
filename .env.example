# Copy to .env for local runs (never commit .env):
#   cp .env.example .env
#
# On Render, set these in the Dashboard → Environment (not via .env file).

# Gemini metadata enrichment — https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Or OpenAI / Anthropic:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Telegram bot (optional — started automatically in Docker when set)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
# TELEGRAM_DEFAULT_STATUS=want_to_read

# WebToEpub runner (defaults match Docker)
# WTE_URL=http://127.0.0.1:8791
